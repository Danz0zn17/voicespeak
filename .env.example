# Cloud base URL. Leave unset to use the official VoiceSpeak cloud.
# SUPABASE_URL=https://your-project-ref.supabase.co

# Written by the box itself on first boot (device-hello). Never type these.
# DEVICE_TOKEN=
# DEVICE_SECRET=
# PAIRING_CODE=
# HARDWARE_ID=   (non-Pi dev machines only; a Pi uses its CPU serial)
# Legacy direct table access - only needed if you run your own Supabase project
# SUPABASE_ANON_KEY=your-anon-key-here

# Voice engine: piper (default, offline), elevenlabs, or espeak
VOICE_ENGINE=piper
PIPER_BIN=piper
PIPER_MODEL=/home/pi/voicespeak/piper/en_US-lessac-medium.onnx

# Optional premium voice - only used if VOICE_ENGINE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: override the default input map
# INPUT_MAP_FILE=/home/pi/voicespeak-app/config/default_input_map.json

# How often to pull phrase changes from the dashboard (seconds, 0 = boot only)
SYNC_INTERVAL_SECONDS=60

# Wi-Fi setup hotspot (voicespeak-setup.service). Leave empty for an open
# "VoiceSpeak-Setup" network; set 8+ characters to require a password.
# SETUP_HOTSPOT_PASSWORD=
# SETUP_PORT=80
